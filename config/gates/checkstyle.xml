<?xml version="1.0"?>
<!-- Gate: backend lint. Locked. The Makefile runs it as a pinned standalone jar with this file,
     so nothing in backend/pom.xml can change or skip it. Deliberately small: it guards the
     template's rules, not taste. Formatting is google-java-format's job (Makefile). -->
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="fileExtensions" value="java"/>
  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile"/>
  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <!-- No disabled tests; no WebFlux; only the Lombok annotations CLAUDE.md allows. -->
    <module name="IllegalImport">
      <property name="illegalPkgs" value="org.springframework.web.reactive, reactor.core,
        org.junit.jupiter.api.condition"/>
      <property name="illegalClasses" value="org.junit.jupiter.api.Disabled, org.junit.Ignore,
        org.junit.jupiter.api.Assumptions, org.junit.Assume,
        org.springframework.test.context.junit.jupiter.DisabledIf,
        org.springframework.test.context.junit.jupiter.EnabledIf,
        lombok.Data, lombok.Setter, lombok.EqualsAndHashCode, lombok.Value, lombok.SneakyThrows"/>
    </module>
    <!-- The same bans written out in full (@lombok.Data, @org.junit.jupiter.api.Disabled), which
         IllegalImport never sees; and Testcontainers' switch that skips tests without Docker. -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="\b(org\.junit\.jupiter\.api\.(Disabled|Assumptions|condition\.)|org\.junit\.(Ignore|Assume)\b|junit\.jupiter\.(DisabledIf|EnabledIf)\b|lombok\.(Data|Setter|EqualsAndHashCode|Value|SneakyThrows)\b|disabledWithoutDocker)"/>
      <property name="message" value="Banned by the template: no disabled, conditional or assumed tests; only the allowed Lombok annotations."/>
      <property name="ignoreComments" value="true"/>
    </module>
    <module name="EqualsHashCode"/>
    <module name="MissingOverride"/>
  </module>
</module>
